# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Who can talk to the bot: Name:telegram_id,Name:telegram_id
# Get IDs via @userinfobot (Telegram still identifies people by numeric ID)
FAMILY_MEMBERS=Тим:111111111,Аня:222222222

# PostgreSQL (used by docker-compose)
POSTGRES_USER=family
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=family_bot
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Timezone for reminders and dates (IANA name)
TIMEZONE=Europe/Moscow

# If Telegram is blocked inside Docker, put a proxy here:
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# From Docker Desktop use host.docker.internal instead of 127.0.0.1
# TELEGRAM_PROXY=socks5://host.docker.internal:1080
